# ── Block Around the Clock · backend configuration ──────────────────────────
# Copy to backend/.env and fill in. Never commit real secrets.

# MongoDB. Leave empty to run with the built-in in-memory store (mongomock).
# Example (local):  mongodb://localhost:27017
# Example (Atlas):  mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true
MONGODB_URI=
MONGODB_DB=block_around_the_clock

# NVIDIA Nemotron via the NVIDIA API catalog (OpenAI-compatible endpoint).
# Leave empty to run the clearly-labelled deterministic demo commander.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_TIMEOUT_SECONDS=30

# Secret key for deterministic HMAC tokenization. Use a long random value.
TOKENIZATION_SECRET=change-me-to-a-long-random-string

# Seconds between simulated containment steps in the war room.
CONTAINMENT_STEP_SECONDS=1.6
# Deterministically fail the first attempt of one adapter to demo failure handling.
SIMULATE_ADAPTER_FAILURE=true

# Seed demo data on startup when the database is empty.
SEED_ON_START=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5050
